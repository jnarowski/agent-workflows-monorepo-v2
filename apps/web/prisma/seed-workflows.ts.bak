  console.log(`Created ${comments.length} workflow comments`);

  // Create Artifacts
  const artifacts = [];

  // Get some steps to attach artifacts to
  const stepsWithArtifacts = [steps[10], steps[11], steps[15], steps[20], steps[25]];

  artifacts.push(
    await prisma.workflowArtifact.create({
